#!name=中国移动爱购购买状态恢复
#!desc=恢复幸运三日签话费券的资格与页面可抢购状态；仅修改前置页面响应，不修改订单或支付结果。
#!author=doosit
#!homepage=https://github.com/doosit/script

[Script]
http-response ^https:\/\/dev\.coc\.10086\.cn\/coc3\/coc3-market-activity\/arrange\/checkQualificByActivityId\/v(?:3|5)(?:\?.*)?$ script-path=https://raw.githubusercontent.com/doosit/script/main/cmcc_aigou_no_qualification_loon.js,requires-body=true,timeout=10,tag=移动爱购购买资格恢复,enable=true
http-response ^https:\/\/dev\.coc\.10086\.cn\/coc3\/coc3-market-activity\/arrange\/getProByActId\?(?:[^#]*&)?activityId=17453(?:&[^#]*)?$ script-path=https://raw.githubusercontent.com/doosit/script/main/cmcc_aigou_no_qualification_loon.js,requires-body=true,timeout=10,tag=移动爱购抢购状态恢复,enable=true

