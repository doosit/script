[Script]
http-request ^https:\/\/m-bms\.cmsk1979\.com\/api\/user\/(?:user\/(?:GetUserAndMallCard|GetMallCard|CheckinBefore)|User\/CheckinV2|Bonus\/ZsskGetHuiDouList)$ script-path=https://raw.githubusercontent.com/doosit/script/main/zhaoshang_garden_checkin.js?v=20260804-6,requires-body=true,timeout=15,tag=招商花园Token获取,enable=true
cron "5 7 * * *" script-path=https://raw.githubusercontent.com/doosit/script/main/zhaoshang_garden_checkin.js?v=20260804-6,timeout=600,tag=招商花园每日签到,enable=true
generic script-path=https://raw.githubusercontent.com/doosit/script/main/zhaoshang_garden_checkin.js?v=20260804-6,timeout=600,argument="manual=1",tag=招商花园手动签到,enable=true

