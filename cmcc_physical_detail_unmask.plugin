#!name = 移动爱购实物商品去时间蒙板
#!desc = 仅解除本次 HAR 中 iPhone Duo 商品详情页的前端开售时间限制，恢复规格选择和后续页面入口。不会自动下单；登录、库存、地区及服务端检查保持原样。启用后重新加载页面，必要时清理页面缓存。
#!author = Codex
#!homepage = https://github.com/doosit/script
#!date = 2026-10-16

# 仅处理实物商品详情页的公共脚本，商品范围由配套脚本再次限定。
[Script]
http-request ^https:\/\/activity\.cmcc-cs\.cn\/website\/h5\/static\/js\/subPackage-physicalGoods-physicalDetail\.[0-9a-f]+\.js(?:\?.*)?$ script-path=https://raw.githubusercontent.com/doosit/script/main/cmcc_physical_detail_unmask_loon.js?v=20261016-1,requires-body=false,timeout=10,tag=实物商品详情脚本缓存刷新,enable=true
http-response ^https:\/\/activity\.cmcc-cs\.cn\/website\/h5\/static\/js\/subPackage-physicalGoods-physicalDetail\.[0-9a-f]+\.js(?:\?.*)?$ script-path=https://raw.githubusercontent.com/doosit/script/main/cmcc_physical_detail_unmask_loon.js?v=20261016-1,requires-body=true,timeout=10,tag=实物商品前端时间蒙板解除,enable=true

[MITM]
hostname = activity.cmcc-cs.cn
